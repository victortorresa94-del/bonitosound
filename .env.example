# ----------------------------------------------------------------------
# IMPORTANTE — Seguridad
# Este fichero SE COMMITEA. Solo placeholders vacíos. Nunca claves reales.
# La key real va en .env.local (gitignored) o en las variables del entorno
# de Vercel / Claude Code on the web. Ver scripts/generate-images.js.
# ----------------------------------------------------------------------

# Backend de formularios (Resend o Formspree). Decisión pendiente con Víctor.
NEXT_PUBLIC_FORM_ENDPOINT=
RESEND_API_KEY=

# Analytics — decisión Víctor (Vercel + Plausible o GA4)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Generación de imágenes — uso build-time, NUNCA expuesto al navegador.
# Se lee en scripts/generate-images.js al ejecutar `npm run generate-images`.
OPENAI_API_KEY=

# fal.ai — generador de vídeos del home.
# Consigue tu key en https://fal.ai/dashboard/keys
# Uso: node scripts/generate-hero-videos-fal.mjs
FAL_KEY=

# Higgsfield — generador alternativo. ID + Secret de
# https://cloud.higgsfield.ai (settings → API keys).
# Uso: node scripts/generate-hero-videos.mjs
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
